        <dependency><groupId>com.qyd</groupId><artifactId>qyd-auth</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.qyd</groupId><artifactId>qyd-venue</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.qyd</groupId><artifactId>qyd-product</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.qyd</groupId><artifactId>qyd-order</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.qyd</groupId><artifactId>qyd-payment</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.qyd</groupId><artifactId>qyd-marketing</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.qyd</groupId><artifactId>qyd-content</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>com.qyd</groupId><artifactId>qyd-settlement</artifactId><version>${project.version}</version></dependency>
