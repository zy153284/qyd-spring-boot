# Copy to deploy/.env and replace every CHANGE_ME value before startup.
DB_PASSWORD=CHANGE_ME_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
REDIS_PASSWORD=CHANGE_ME_redis_password
# At least 32 random bytes; use a secret manager in production.
JWT_SECRET=CHANGE_ME_at_least_32_random_bytes
QYD_ADMIN_USERNAME=admin
QYD_ADMIN_PASSWORD=CHANGE_ME_initial_admin_password
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
